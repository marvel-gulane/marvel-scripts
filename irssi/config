# ============================================================
# Irssi Configuration
# Beginner-friendly / robust setup
# ============================================================
#
# Main files:
#   ~/.irssi/config
#   ~/.irssi/github.theme
#
# Start Irssi:
#   irssi
#
# Useful commands:
#   /connect irc.libera.chat
#   /join #channel
#   /nick YourNick
#   /window list
#   /help
#   /quit
#
# ============================================================


settings = {
    core = {
        real_name = "IRC User";
        user_name = "ircuser";
        nick = "NewUser";

        quit_message = "Leaving IRC. See you!";
        part_message = "See you!";
        show_quit_once = "yes";

        recode = "yes";
        settings_autosave = "yes";
        use_status_window = "yes";
        print_active_channel = "yes";
    };

    "fe-common/core" = {
        theme = "github";

        autolog = "yes";
        autolog_path = "~/.irssi/logs/$tag/$0.log";

        use_colors = "yes";
        beep_msg_level = "HILIGHT MSGS DCCMSGS";
        bell_beeps = "yes";

        completion_char = " ";
        completion_keep_privates = "yes";
        completion_auto = "yes";
        completion = "normal";

        expand_quoted = "yes";
        autoclosequery = "no";

        timestamps = "yes";
        timestamp_format = "%H:%M";

        activity_hide_targets = "no";
        activity_msg_level = "MSGS NOTICES DCCMSGS";
        activity_status_window = "yes";

        hilight_nicks = "yes";
        hilight_nick_matches = "yes";

        autostick_split_windows = "yes";
        autocreate_own_query = "yes";

        window_check_level = "MSGCHANGE";
        scrollback_time = "7days";
        scrollback_lines = "5000";

        show_nickmode = "yes";
        show_nickmode_empty = "yes";

        max_channel_name_len = "50";
        max_nick_length = "32";
    };

    "fe-common/irc" = {
        channel_max_len = "200";
        show_names_on_join = "yes";

        join_auto_chans = "no";
        auto_whowas = "yes";

        ctcp_version_reply = "Irssi IRC client";
        ctcp_version_reply_client = "Irssi";
    };

    "fe-text" = {
        actlist_sort = "refnum";
        autostick_split_windows = "yes";

        term_charset = "UTF-8";
        use_terminfo = "yes";

        scroll_page_count = "2";

        theme = "github";

        indent = "yes";
        show_nickmode = "yes";
        show_nickmode_empty = "yes";

        beep_msg_level = "HILIGHT MSGS";
        beep_when_away = "no";
    };
};


# ============================================================
# SERVER SETTINGS
# ============================================================

servers = (
    {
        address = "irc.libera.chat";
        chatnet = "LiberaChat";
        port = "6697";
        use_tls = "yes";
        tls_verify = "yes";
        autoconnect = "no";
        autosendcmd = "/^msg NickServ IDENTIFY YourPassword";
    }
);


# ============================================================
# NETWORK / CHATNET SETTINGS
# ============================================================

chatnets = {
    LiberaChat = {
        type = "IRC";
        autosendcmd = "";
        max_kicks = "4";
        max_modes = "4";
        max_msgs = "4";
        max_whois = "4";
        max_targets = "4";
    };
};


# ============================================================
# CHANNELS
# ============================================================

channels = (
    {
        name = "#libera";
        chatnet = "LiberaChat";
        autojoin = "no";
    }
);


# ============================================================
# ALIASES
# ============================================================

aliases = {
    # Basic
    J = "join";
    P = "part";
    Q = "quit";
    W = "whois";
    N = "nick";

    # Windows
    WLIST = "window list";
    WNEXT = "window next";
    WPREV = "window prev";
    WS = "window server";

    # Messaging
    M = "msg";
    R = "query";
    ME = "action";

    # IRC information
    WHO = "who";
    WHOIS = "whois";
    NAMES = "names";
    TOPIC = "topic";

    # Convenience
    CLEAR = "clear";
    HELP = "help";
    RELOAD = "script load ~/.irssi/scripts/startup.pl";
};


# ============================================================
# STATUS BAR
# ============================================================

statusbar = {
    items = {
        barstart = "{sbstart}";
        time = "{sb $Z}";
        user = "{sb $cumode$usermode}";
        window = "{sb $winref $name}";
        prompt = "{prompt $[.12]}";
        input = "{input}";
        lag = "{sb Lag: $0}";
        act = "{sb Act: $0}";
    };

    default = {
        window = {
            priority = "1";
            alignment = "left";
            visible = "always";
        };

        window_empty = {
            priority = "2";
            alignment = "left";
            visible = "always";
        };

        prompt = {
            priority = "10";
            alignment = "left";
            visible = "always";
        };

        input = {
            priority = "10";
            alignment = "left";
            visible = "always";
        };

        time = {
            priority = "100";
            alignment = "right";
            visible = "always";
        };
    };
};


# ============================================================
# COMPLETION / HIGHLIGHTING
# ============================================================

hilights = (
    {
        text = "NewUser";
        nick = "yes";
        word = "yes";
        level = "MSGS NOTICES";
    }
);


# ============================================================
# IGNORE SETTINGS
# ============================================================

ignores = (
);


# ============================================================
# WINDOWS
# ============================================================

windows = (
    {
        name = "(status)";
        refnum = "1";
    }
);


# ============================================================
# LOGGING
# ============================================================

logs = (
);


# ============================================================
# ADVANCED / SAFETY
# ============================================================

settings = {
    core = {
        # Do not automatically execute arbitrary commands received
        # from servers.
        real_name = "IRC User";

        # UTF-8 is the safest default for modern IRC.
        recode = "yes";

        # Save settings when changed.
        settings_autosave = "yes";
    };
};
